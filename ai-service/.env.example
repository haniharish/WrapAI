# ===============================================
# WrapAI Python AI Microservice Configuration
# ===============================================

# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Internal Service Authentication Key
AI_SERVICE_API_KEY=wrapai_internal_ai_service_secret_key_minimum_32_chars_2026

# Faster-Whisper Speech-to-Text Model Settings
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small

# Device: cpu or cuda
WHISPER_DEVICE=cpu

# Compute Type: int8, float16, float32
# Note: int8 is optimal for CPU inference; float16 is optimal for CUDA GPUs
WHISPER_COMPUTE_TYPE=int8

# VAD (Voice Activity Detection) Filter
WHISPER_VAD_FILTER=true

# Resource Limits
MAX_FILE_SIZE_BYTES=524288000
MAX_AUDIO_DURATION_SECONDS=14400
TRANSCRIPTION_TIMEOUT_SECONDS=600

# Storage / Temp Directory
TEMP_DIR=
