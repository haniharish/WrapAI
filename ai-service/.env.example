# ===============================================
# WrapAI Python AI Microservice Configuration
# ===============================================

# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Internal Service Authentication Key
AI_SERVICE_API_KEY=wrapai_internal_ai_service_secret_key_minimum_32_chars_2026

# Faster-Whisper Speech-to-Text Model Settings
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true

# Speaker Diarization Settings (pyannote.audio)
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu

# LLM Content Intelligence Settings
# Provider: heuristic, gemini, openai
LLM_PROVIDER=heuristic
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
MAX_TRANSCRIPT_TOKENS_PER_CHUNK=3000

# Resource Limits
MAX_FILE_SIZE_BYTES=524288000
MAX_AUDIO_DURATION_SECONDS=14400
TRANSCRIPTION_TIMEOUT_SECONDS=600

# Storage / Temp Directory
TEMP_DIR=
