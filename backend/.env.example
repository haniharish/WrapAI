# ==========================================
# WrapAI Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wrapai?retryWrites=true&w=majority

# Redis & BullMQ Background Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379
PROCESSING_QUEUE_NAME=content-processing
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=2000
MOCK_PROCESSING_FAILURE=false

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Object Storage (AWS S3 or Local Fallback)
STORAGE_PROVIDER=AWS_S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=wrapai-content-storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SIGNED_URL_EXPIRATION=3600

# File Size & Text Bounds
MAX_AUDIO_SIZE=104857600
MAX_VIDEO_SIZE=524288000
MAX_DOCUMENT_SIZE=52428800
MAX_TEXT_LENGTH=100000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# AI Service & LLM Intelligence
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_internal_service_api_key_minimum_32_characters

# Phase 10: Embeddings & Vector Search (RAG)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.35
MAX_RAG_CONTEXT_TOKENS=3000
MAX_CHAT_HISTORY_MESSAGES=6

# Phase 11: Report Generation & Sharing
REPORT_QUEUE_NAME=report-generation
REPORT_WORKER_CONCURRENCY=2
REPORT_STORAGE_PREFIX=reports
REPORT_MAX_FILE_SIZE=26214400
REPORT_SHARE_EXPIRATION_DAYS=7

# Logging
LOG_LEVEL=info

